{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "version": "2025.10",
  "name": "Nuance Design Language",
  "description": "One design language for thenuanceproject.com and WireTrace.",
  "sets": {
    "base": {
      "sources": [
        {
          "$ref": "tokens/base.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "contexts": {
        "light": [
          {
            "$ref": "tokens/theme/light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "tokens/theme/dark.tokens.json"
          }
        ]
      },
      "default": "light"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/theme"
    }
  ]
}
